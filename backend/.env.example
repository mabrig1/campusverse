DATABASE_URL="postgresql://..."
JWT_SECRET="generate-a-real-one-with-openssl-rand-base64-32"
PORT=5000

# Optional — enables "Sign in with Google".
GOOGLE_CLIENT_ID=""

# Dedicated CampusVerse administrator bootstrap. These are used only when
# no ADMIN user exists yet; never commit real values to Git.
ADMIN_NAME="CampusVerse Administrator"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@campusverse.store"
ADMIN_PASSWORD="replace-with-a-strong-12-plus-character-password"

# Password reset email delivery (Resend).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CampusVerse <noreply@campusverse.store>"

# Referral / image storage
PUBLIC_APP_URL="https://www.campusverse.store"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="campusverse"

# OpenRouter AI — server-side only. Never use VITE_ for the key.
OPENROUTER_API_KEY=""
# Low-cost default; restrict requests to this model or your chosen models.
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_ALLOWED_MODELS="openrouter/free"
# Keep responses concise to reduce latency and token spend.
OPENROUTER_MAX_TOKENS="800"
OPENROUTER_SYSTEM_PROMPT=""

# Required for laptop listing serial fingerprints and encrypted private receipt photographs.
# Generate securely: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never commit the generated key, print it to logs, or expose it as VITE_.
LAPTOP_PROOF_ENCRYPTION_KEY_BASE64=""

# First launch: only this existing ADMIN account may review device documents and manage deals.
TRADING_OWNER_EMAIL=""

# Owner-managed pilot defaults to TRUE if unset; do not enable legacy wallet/escrow self-service for launch.
CAMPUSVERSE_OWNER_MANAGED_LAUNCH="true"

# Pilot = ONLY one physical CampusVerse store, for months of private testing.
# No independent stores or student-to-student sales; false is reserved for a future explicitly approved launch.
# The single-store gate is enforced in backend code, not unlocked by changing this setting.
CAMPUSVERSE_PERSONAL_STORE_ONLY="true"
