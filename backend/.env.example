DATABASE_URL="file:./dev.db"
JWT_SECRET="generate-a-real-one-with-openssl-rand-base64-32"
PORT=5000

# Optional — enables "Sign in with Google". Same OAuth Client ID as the
# frontend's VITE_GOOGLE_CLIENT_ID (Client IDs aren't secret; only a
# Client Secret would be, and this ID-token-verification flow doesn't
# need one). Without this set, /api/auth/google returns 503.
GOOGLE_CLIENT_ID=""
