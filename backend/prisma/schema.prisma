generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String?  @unique
  passwordHash String
  role      Role     @default(STUDENT)
  regNo     String?
  hostel    String?
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())

  phoneVerified     Boolean @default(false)
  emailVerified     Boolean @default(false)
  studentIdVerified Boolean @default(false)
  selfieVerified    Boolean @default(false)
  ninVerified       Boolean @default(false)
  bvnVerified       Boolean @default(false)
  disputeCount      Int     @default(0)

  wallet   Wallet?
  products Product[]
  reviews  Review[]
  escrowsAsBuyer  EscrowTransaction[] @relation("Buyer")
  escrowsAsSeller EscrowTransaction[] @relation("Seller")
  favorites  Favorite[]
  reports    Report[]
  promotions Promotion[]
}

model Wallet {
  id           String        @id @default(cuid())
  balance      Float         @default(0)
  user         User          @relation(fields: [userId], references: [id])
  userId       String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

enum TransactionType {
  TOPUP
  TRANSFER_IN
  TRANSFER_OUT
  ESCROW_LOCK
  ESCROW_RELEASE
  ESCROW_REFUND
}

model Transaction {
  id        String          @id @default(cuid())
  wallet    Wallet          @relation(fields: [walletId], references: [id])
  walletId  String
  type      TransactionType
  amount    Float
  note      String
  createdAt DateTime        @default(now())
  @@index([walletId])
}

enum ConditionType { NEW USED }
enum PromotionTier { NONE PINNED HIGHLIGHTED FEATURED }

model Product {
  id                   String        @id @default(cuid())
  title                String
  description          String
  price                Float
  category             String
  conditionType        ConditionType @default(USED)
  condition            String
  location             String
  imagesJson           String
  stock                Int           @default(1)
  inspectionRequired   Boolean       @default(false)
  inspectionReportJson String?
  viewCount            Int           @default(0)
  promotionTier        PromotionTier @default(NONE)
  promotionExpiresAt   DateTime?
  seller               User          @relation(fields: [sellerId], references: [id])
  sellerId             String
  createdAt            DateTime      @default(now())
  reviews     Review[]
  escrows     EscrowTransaction[] @relation("ProductEscrows")
  favoritedBy Favorite[]
  reports     Report[]
  promotions  Promotion[]
  @@index([sellerId])
  @@index([category])
  @@index([location])
  @@index([promotionTier])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
  @@unique([userId, productId])
  @@index([productId])
}

model Report {
  id        String   @id @default(cuid())
  reporter  User     @relation(fields: [reporterId], references: [id])
  reporterId String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  @@index([productId])
  @@index([status])
}

model Promotion {
  id            String        @id @default(cuid())
  product       Product       @relation(fields: [productId], references: [id])
  productId     String
  buyer         User          @relation(fields: [buyerId], references: [id])
  buyerId       String
  tier          PromotionTier
  days          Int
  cost          Float
  provider      String        @default("SIMULATED")
  paymentStatus String        @default("PAID")
  purchasedAt   DateTime      @default(now())
  expiresAt     DateTime
  @@index([productId])
  @@index([buyerId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
  @@index([productId])
}

enum EscrowStatus { FUNDS_LOCKED INSPECTED FUNDS_RELEASED DISPUTED REFUNDED }

model EscrowTransaction {
  id                String       @id @default(cuid())
  product           Product      @relation("ProductEscrows", fields: [productId], references: [id])
  productId         String
  buyer             User         @relation("Buyer", fields: [buyerId], references: [id])
  buyerId           String
  seller            User         @relation("Seller", fields: [sellerId], references: [id])
  sellerId           String
  price             Float
  status            EscrowStatus @default(FUNDS_LOCKED)
  inspectionStatus  String       @default("pending")
  inspectionScore   Int          @default(0)
  disputeStatus     String       @default("none")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  @@index([productId])
  @@index([buyerId])
  @@index([sellerId])
}
