# The deployed backend's URL, with /api appended (e.g. https://campusverse-backend.vercel.app/api)
VITE_API_URL="http://localhost:5000/api"

# Optional — enables "Sign in with Google" on the login screen. Get this
# from Google Cloud Console → APIs & Services → Credentials → OAuth client
# ID. Not secret (Client IDs are meant to be public/embedded in frontend
# code) — do not confuse with a Client Secret, which this app never needs.
VITE_GOOGLE_CLIENT_ID=""

# Optional — powers map/location features (not yet built). Same key can
# also be set as GOOGLE_MAPS_API_KEY on the backend for server-side
# Geocoding/Routes calls.
VITE_GOOGLE_MAPS_API_KEY=""
