# =============================================================
#  CampusVerse – Environment Variables Reference
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env file to git.
# =============================================================

# ── NODE ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MONGODB ──────────────────────────────────────────────────
# Dedicated user: campusverse_user / CampusVerse2026
MONGODB_URI=mongodb+srv://campusverse_user:CampusVerse2026@learnhub.07ozegd.mongodb.net/campusverse_db?retryWrites=true&w=majority&appName=learnhub
MONGODB_DB_NAME=campusverse_db

# ── JWT / AUTH ────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_min_64_chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://campusverse.store,https://www.campusverse.store

# ── FRONTEND (Vite build-time variables) ─────────────────────
# Set these in your hosting platform's build environment
VITE_API_URL=https://api.campusverse.store/api

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── OPTIONAL: Email / Notifications ──────────────────────────
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@campusverse.store
# SMTP_PASS=CHANGE_ME
# EMAIL_FROM=no-reply@campusverse.store

# ── OPTIONAL: Paystack (escrow payments) ─────────────────────
# PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
# PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
