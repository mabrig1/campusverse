# =============================================================
#  CampusVerse — Environment Variables Reference
#  Copy backend/.env.example to backend/.env and fill values.
#  NEVER commit a real .env file to git.
# =============================================================

# ── CORE ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── MONGODB ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://campusverse_user:CampusVerse2026@learnhub.07ozegd.mongodb.net/campusverse_db?retryWrites=true&w=majority&appName=learnhub
MONGODB_DB_NAME=campusverse_db

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=<generate: openssl rand -base64 64>
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://campusverse.store,https://www.campusverse.store
FRONTEND_URL=https://campusverse.store

# ── CLOUDINARY (image/avatar uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# ── EMAIL — RESEND ────────────────────────────────────────────
RESEND_API_KEY=<your_resend_key>
RESEND_FROM_EMAIL=noreply@campusverse.store

# ── PAYMENTS — PAYSTACK ───────────────────────────────────────
PAYSTACK_PUBLIC_KEY=<pk_live_...>
PAYSTACK_SECRET_KEY=<sk_live_...>

# ── AI SERVICES ───────────────────────────────────────────────
OPENAI_API_KEY=<sk-proj-...>
ANTHROPIC_API_KEY=<sk-ant-api03-...>
XAI_API_KEY=<xai-...>
GEMINI_API_KEY=<AIza...>

# ── RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── FRONTEND (Vite build-time — set in Vercel dashboard) ──────
# VITE_API_URL=https://your-railway-app.up.railway.app/api
